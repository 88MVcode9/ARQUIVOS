          "texto": "Por não terem conteúdo patrimonial disponível, não podem ser transferidos a terceiros."
        },
        {
          "tipo": "atencao",
          "titulo": "Imprescritibilidade",
          "texto": "Não se perdem pelo decurso do tempo; o titular pode exigir sua proteção a qualquer momento."
        },
        {
          "tipo": "atencao",

      "titulo": "Características dos Direitos Humanos",
      "cards": [
        {
          "tipo": "atencao",
          "titulo": "Universalidade",
          "texto": "Aplicam-se a todo ser humano, sem distinção de nacionalidade, raça, gênero, religião ou qualquer outra condição."

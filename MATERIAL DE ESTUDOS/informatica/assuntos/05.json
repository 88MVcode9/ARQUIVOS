          "titulo": "Finder — Gerenciador de Arquivos do macOS",
          "imagem": "https://help.apple.com/assets/68AF4A4B86D71687240E66F4/68AF4A565F6C67F4540CDAC2/pt_BR/5fcd78d45dd358e365371ee46e04fef8.png"

{
  "materia": "Legislação Municipal de Aracaju",
  "titulo": "RESUMO",
  "descricao_geral": "Resumo completo das principais leis municipais de Aracaju e da legislação federal aplicável às Guardas Municipais, cobradas em concursos. Abrange o Estatuto Geral das Guardas Municipais (Lei 13.022/2014), a Lei Orgânica do Município de Aracaju (LOMA), o Estatuto dos Servidores de Aracaju (LC 153/2016) e a estrutura da Polícia Municipal de Aracaju (PMA). Inclui princípios, competências, requisitos, prazos, hierarquia, carreira, controle interno/externo, processo legislativo, regime disciplinar, vencimentos, adicionais, e pegadinhas frequentes.",
  "topicos": [
    {
      "titulo": "Estatuto Geral das Guardas Municipais (Lei nº 13.022/2014)",
      "cards": [
        {
          "tipo": "atencao",
          "titulo": "Natureza e princípios",
          "texto": "As guardas municipais são órgãos de segurança pública (art. 144, §8º, CF), de caráter civil, comunitário e preventivo. Princípios: proteção dos direitos humanos, preservação da vida, redução do sofrimento, proximidade com a comunidade e atuação em parceria com os demais órgãos de segurança."
        },
        {
          "tipo": "atencao",
          "titulo": "Competências (Art. 4º)",
          "texto": "Zelar por bens, equipamentos e instalações municipais; prestar socorro em acidentes/calamidades; exercer policiamento administrativo (posturas, uso do solo); atuar na segurança de escolas, hospitais e terminais municipais; cooperar com outros entes, respeitando as competências de cada um."
        },
        {
          "tipo": "atencao",
          "titulo": "Pegadinha federal clássica",
          "texto": "A GM NÃO realiza investigação criminal (Polícia Civil) nem policiamento ostensivo repressivo (Polícia Militar). A lei veda atribuições próprias das polícias Civil e Militar."
        },
        {
          "tipo": "atencao",
          "titulo": "Porte de arma e uniforme",
          "texto": "A Lei 13.022/2014 autoriza o porte de arma de fogo, respeitando o Estatuto do Desarmamento (curso de tiro, aptidão psicológica e autorização do Comandante). O uniforme deve ser distinto dos uniformes das polícias estaduais (preferencialmente azul-marinho)."
        },
        {
          "tipo": "atencao",
          "titulo": "Requisitos para investidura (Art. 10)",
          "texto": "Nacionalidade brasileira, gozo dos direitos políticos, quitação militar e eleitoral, nível médio completo, idade mínima de 18 anos, aptidão física/mental/psicológica, idoneidade moral (investigação social e certidões). A lei não exige nível superior nem idade máxima."
        },
        {
          "tipo": "atencao",
          "titulo": "Limites de efetivo (Art. 7º)",
          "texto": "Até 50.000 hab: 0,4%; de 50.001 a 500.000 hab: 0,3% (mínimo 200); acima de 500.000 hab: 0,2% (mínimo 1.500). Percentuais decrescentes com o aumento da população."
        },
        {
          "tipo": "atencao",
          "titulo": "Corregedoria e Ouvidoria (Art. 13)",
          "texto": "Corregedoria (controle interno): obrigatória em municípios com mais de 50.000 hab OU em qualquer município que utilize arma de fogo. Ouvidoria (controle externo e independente): recebe elogios, denúncias e reclamações da população."
        },
        {
          "tipo": "atencao",
          "titulo": "Cargos de comando (Arts. 14 e 15)",
          "texto": "Os cargos em comissão e funções de confiança devem ser providos por membros de carreira. O comando da Guarda é privativo de integrante da carreira (a exceção dos 4 primeiros anos já expirou)."
        },
        {
          "tipo": "atencao",
          "titulo": "Prisão especial e uniforme (Arts. 18 e 19)",
          "texto": "Prisão especial: em caso de prisão antes da condenação definitiva, o guarda tem direito a cela isolada. Uniforme: preferencialmente azul-marinho, nitidamente distinto das Forças Armadas e polícias estaduais."
        },
        {
          "tipo": "atencao",
          "titulo": "Jurisprudência do STF (ADPF 995)",
          "texto": "As Guardas Municipais integram o sistema de segurança pública. Podem realizar busca pessoal e prisão em flagrante, desde que haja fundada suspeita e a ação esteja ligada à tutela dos bens/serviços municipais ou a crimes em andamento. A vedação à investigação criminal permanece."
        },
        {
          "tipo": "bizu",
          "titulo": "Mnemônico",
          "texto": "📌 GM pode andar armada, mas NÃO investiga. Corregedoria obrigatória se usar arma ou tiver >50.000 hab. Comandante deve ser da carreira."

      ]
    },
    {
      "titulo": "Lei Orgânica do Município de Aracaju (LOMA) – Executivo e Legislativo",
      "cards": [
        {
          "tipo": "atencao",
          "titulo": "Prefeito e Vice-Prefeito – requisitos e idades",
          "texto": "Idade mínima: 21 anos para ambos. Estar em pleno exercício dos direitos políticos, eleitos por voto direto (maioria absoluta em 1º turno ou maioria simples em 2º). PEGADINHA: Prefeito/Vice = 21 anos; Vereador = 18 anos."

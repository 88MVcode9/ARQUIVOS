        },
        {
          "tipo": "atencao",
          "titulo": "Formas de vacância",
          "texto": "Exoneração (a pedido ou de ofício – NÃO é punição), demissão (penalidade), aposentadoria, posse em outro cargo inacumulável, falecimento."
        },
        {
          "tipo": "atencao",
          "titulo": "Férias e concessões (gala e nojo)",
          "texto": "Férias: 30 dias, fracionamento em até 3 períodos (um mínimo de 14 dias), abono de 1/3. Concessões: casamento (gala) – até 8 dias; falecimento (nojo) – até 8 dias para cônjuge/companheiro, pais, filhos, irmãos ou dependentes."
        },
        {
          "tipo": "atencao",
